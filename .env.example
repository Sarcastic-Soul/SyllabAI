# Neon PostgreSQL Connection String
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# Google Gemini API Key
GEMINI_API_KEY=

# Neon Auth (Managed Better Auth): sign-in with Google or email and password.
# Auth URL: Neon console -> project -> branch -> Auth -> Configuration.
NEON_AUTH_BASE_URL=
# Any random secret, used to sign the session cookie. Generate with:
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Razorpay (test mode keys start with rzp_test_).
# Key ID and secret: Razorpay dashboard -> Account & Settings -> API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A secret you choose yourself when adding the webhook:
# Razorpay dashboard -> Account & Settings -> Webhooks -> Add New Webhook.
# Webhook URL: https://syllabai-edu.vercel.app/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# Only for `pnpm eval` (retrieval eval); the app itself never reads this.
# The eval writes temporary courses and chunks, then deletes them.
# Best: a separate database or Neon branch with pgvector and the migrations applied.
# With one database only, run:
#   EVAL_DATABASE_URL="$DATABASE_URL" pnpm eval --allow-app-db
EVAL_DATABASE_URL=
